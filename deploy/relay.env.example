# Generated on first install; /etc/aster-capacity-relay/environment is preserved.
ASTER_RELAY_TOKEN=replace-with-a-generated-random-token
ASTER_RELAY_HOST=0.0.0.0
ASTER_RELAY_PORT=8766
ASTER_RELAY_SYMBOLS=XAUUSD1
ASTER_RELAY_INTERVAL=0.2
ASTER_RELAY_BRACKETS_INTERVAL=60
ASTER_RELAY_CERT_FILE=/etc/aster-capacity-relay/server.crt
ASTER_RELAY_KEY_FILE=/etc/aster-capacity-relay/server.key
