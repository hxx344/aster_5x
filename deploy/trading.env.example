# systemd EnvironmentFile; edit only on the Linux server.
ASTER_DASHBOARD_PASSWORD=replace-with-at-least-16-random-characters
ASTER_ALLOW_LIVE=0
# HTTPS public origin without trailing slash. Omit when using the SSH tunnel.
# ASTER_PUBLIC_ORIGIN=https://aster.example.com
# Copy the Pro API user address, API signer address and API agent private key.
# Do not put your main wallet private key here.
# ASTER_A_USER=0x...
# ASTER_A_SIGNER=0x...
# ASTER_A_PRIVATE_KEY=0x...
# ASTER_B_USER=0x...
# ASTER_B_SIGNER=0x...
# ASTER_B_PRIVATE_KEY=0x...
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
# FEISHU_SIGN_SECRET=...
