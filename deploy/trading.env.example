# systemd EnvironmentFile; edit only on the Linux server.
ASTER_DASHBOARD_PASSWORD=replace-with-at-least-16-random-characters
ASTER_ALLOW_LIVE=0
# HTTPS public origin without trailing slash. Omit when using the SSH tunnel.
# ASTER_PUBLIC_ORIGIN=https://aster.example.com
# Copy the Pro API user address, API signer address and API agent private key.
# Do not put your main wallet private key here.
# ASTER_A_USER=0x...
# ASTER_A_SIGNER=0x...
# ASTER_A_PRIVATE_KEY=0x...
# ASTER_B_USER=0x...
# ASTER_B_SIGNER=0x...
# ASTER_B_PRIVATE_KEY=0x...
# Shared by public capacity alerts and live trade summaries; existing settings are preserved on upgrade.
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
# FEISHU_SIGN_SECRET=...
# Public alerts reuse market polling, independent of trading accounts and their thresholds.
# Defaults: enabled when a Webhook is configured, strictly above 10000 USD1,
# and at least 300 seconds between successful alerts after capacity falls and rises again.
# Set ASTER_CAPACITY_ALERT_ENABLED=0 to disable only public alerts; live trade summaries stay enabled.
# ASTER_CAPACITY_ALERT_ENABLED=1
# ASTER_CAPACITY_ALERT_THRESHOLD=10000
# ASTER_CAPACITY_ALERT_COOLDOWN_SECONDS=300
